# ===========================================
# ENVIRONMENT VARIABLES TEMPLATE
# ===========================================
# 
# SECURITY INSTRUCTIONS:
# 1. NEVER commit this file with real secrets - only use placeholders
# 2. NEVER share your .env file or include it in version control
# 3. Copy this file to .env and replace placeholders with real values
# 4. Rotate any secrets that were accidentally exposed
#
# ===========================================

# Supabase Configuration
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key-here"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# ===========================================
# EDGE FUNCTION SECRETS (via Secrets Manager)
# ===========================================
# These secrets are stored securely and accessed via Deno.env.get()
# NEVER hardcode these values in source code
#
# Required:
# - SUPABASE_URL (auto-configured)
# - SUPABASE_SERVICE_ROLE_KEY (auto-configured)
# - SUPABASE_ANON_KEY (auto-configured)
#
# Email Service:
# - RESEND_API_KEY (for email sending)
#
# AI Services:
# - LOVABLE_API_KEY (auto-configured by platform)
#
# Optional Integrations:
# - Shopify credentials are stored encrypted in the database
# - CRM API keys are stored encrypted in the database
#
# ===========================================

# NOTE: The following are examples of values that should NEVER be in code:
# ❌ sk_live_abc123... (Stripe secret key)
# ❌ eyJhbGciOi... (JWT tokens)
# ❌ postgres://user:password@host:5432/db (Connection strings)
# ❌ AKIA... (AWS access keys)

# Set to "true" only while emails cannot reach clients (no verified sending domain).
# Clients/staff then sign in with password only; admins still get the emailed code.
# VITE_SKIP_CLIENT_LOGIN_OTP="true"
